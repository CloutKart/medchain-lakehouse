{
  "_comment": "Datasets for pl_ingest_source. All are parameterised on source_name so the seven sources share one pipeline; adding an eighth is a config change in pl_master's sources array, not a new pipeline.",

  "ds_landing_folder": {
    "name": "ds_landing_folder",
    "properties": {
      "type": "Binary",
      "linkedServiceName": { "referenceName": "ls_adls_medchain", "type": "LinkedServiceReference" },
      "parameters": { "source_name": { "type": "String" } },
      "typeProperties": {
        "location": {
          "type": "AzureBlobFSLocation",
          "fileSystem": "landing",
          "folderPath": "@dataset().source_name"
        }
      },
      "annotations": ["medchain", "landing"]
    }
  },

  "ds_landing_binary": {
    "name": "ds_landing_binary",
    "properties": {
      "type": "Binary",
      "linkedServiceName": { "referenceName": "ls_adls_medchain", "type": "LinkedServiceReference" },
      "parameters": { "source_name": { "type": "String" } },
      "typeProperties": {
        "location": {
          "type": "AzureBlobFSLocation",
          "fileSystem": "landing",
          "folderPath": "@dataset().source_name"
        }
      },
      "annotations": ["medchain", "landing"]
    }
  },

  "ds_bronze_binary": {
    "name": "ds_bronze_binary",
    "properties": {
      "type": "Binary",
      "linkedServiceName": { "referenceName": "ls_adls_medchain", "type": "LinkedServiceReference" },
      "parameters": {
        "source_name": { "type": "String" },
        "ingest_date": { "type": "String" }
      },
      "typeProperties": {
        "location": {
          "type": "AzureBlobFSLocation",
          "fileSystem": "bronze",
          "_comment": "Hive-style partition path. The Bronze notebook also derives ingest_date from the file name, so the two agree and a single day can be reprocessed with replaceWhere.",
          "folderPath": "@concat('_landed/', dataset().source_name, '/ingest_date=', dataset().ingest_date)"
        }
      },
      "annotations": ["medchain", "bronze"]
    }
  }
}
